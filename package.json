{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:customer": "vite build --config customer-portal/vite.config.ts",
    "preview": "vite preview",
    "preview:customer": "vite preview --config customer-portal/vite.config.ts --port 4173",
    "clean": "rm -rf dist dist-customer server.js",
    "lint": "tsc --noEmit",
    "lint:customer": "tsc -p customer-portal/tsconfig.json --noEmit",
    "test:phase2": "tsx --test tests/phase2/*.test.ts",
    "test:phaseC": "tsx --test tests/phaseC/*.test.ts",
    "test:phase3a": "tsx --test tests/phase3a/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "gsap": "^3.15.1",
    "jose": "^6.2.18",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
