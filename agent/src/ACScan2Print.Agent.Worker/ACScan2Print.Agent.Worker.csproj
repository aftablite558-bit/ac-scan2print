<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ACScan2Print.Agent.Worker-12345678</UserSecretsId>
    <RootNamespace>ACScan2Print.Agent.Worker</RootNamespace>
    <AssemblyName>ACScan2Print.Agent.Worker</AssemblyName>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Company>Aman Computer</Company>
    <Product>AC Scan2Print Local Print Agent</Product>
    <Description>Windows 11 background service for AC Scan2Print job claiming and spooler execution.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ACScan2Print.Agent.Core\ACScan2Print.Agent.Core.csproj" />
    <ProjectReference Include="..\ACScan2Print.Agent.Infrastructure\ACScan2Print.Agent.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>
</Project>
